#!/usr/bin/env python3
"""Entry point: python3 -I bin/crewkit <command> [workspace] [options]"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from crewkit.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
